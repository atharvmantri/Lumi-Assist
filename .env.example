# Lumi environment variables
# install.bat writes the key for the provider you select into .env.
# If configuring manually, copy this file to .env and uncomment/fill one key.

# Hack Club AI: https://ai.hackclub.com/
HACKCLUB_API_KEY=your_key_here

# Other supported OpenAI-compatible providers:
# OPENROUTER_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here
# CUSTOM_API_KEY=your_key_here
